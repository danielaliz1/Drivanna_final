<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Drivana"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.entrada.EntradaActivity"
            android:exported="true"
            android:theme="@style/Theme.Drivana.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Drivana.NoActionBar" />

        <activity
            android:name=".ui.auth.RegistroActivity"
            android:exported="false"
            android:theme="@style/Theme.Drivana.NoActionBar" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Drivana.NoActionBar" />

        <activity
            android:name=".ui.cuenta.AyudaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.cuenta.PrivacidadActivity"
            android:exported="false" />

        <activity
            android:name=".ui.cuenta.ConfiguracionActivity"
            android:exported="false" />

    </application>

</manifest>
