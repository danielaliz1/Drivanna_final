<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Drivana" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/drivana_red</item>
        <item name="colorPrimaryDark">@color/drivana_red_dark</item>
        <item name="colorAccent">@color/drivana_amber</item>
        <item name="android:statusBarColor">@color/drivana_white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.Drivana.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
